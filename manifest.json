{
  "manifest_version": 3,
  "name": "YouTube Queue",
  "version": "1.0",
  "author": "ryanmgreen0-svg",
  "description": "Save YouTube videos to a queue and view on GitHub website",
  "permissions": ["contextMenus", "storage", "activeTab", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://youtube.com/*", "*://*.youtu.be/*", "*://youtu.be/*"],
      "js": ["content.js"]
    },
    {
      "matches": [
        "https://ryanmgreen96.github.io/youtubeque/*",
        "https://ryanmgreen0-svg.github.io/youtubeque/*"
      ],
      "js": ["queue.js"]
    }
  ]
}